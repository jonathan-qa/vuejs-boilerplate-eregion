{
  "name": "vue-boilerplate-eregion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "node scripts/run-vue-cli.js serve",
    "build": "node scripts/run-vue-cli.js build",
    "test:unit": "node scripts/run-vue-cli.js test:unit",
    "test:e2e": "node scripts/run-vue-cli.js test:e2e",
    "test:performance": "newman run tests/performance/trweb-app-performance-test.postman_collection.json",
    "lint": "node scripts/run-vue-cli.js lint"
  },
  "cypress-cucumber-preprocessor": {
    "step_definitions": "tests/e2e/step_definitions/"
  },
  "dependencies": {
    "core-js": "^3.4.3",
    "cypress-cucumber-preprocessor": "^1.19.0",
    "node-sass": "^7.0.0",
    "vue": "^2.6.10",
    "vue-router": "^3.1.3",
    "vuex": "^3.1.2"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "^4.1.0",
    "@vue/cli-plugin-e2e-cypress": "^4.1.0",
    "@vue/cli-plugin-eslint": "^4.1.0",
    "@vue/cli-plugin-router": "^4.1.0",
    "@vue/cli-plugin-unit-jest": "^4.1.0",
    "@vue/cli-plugin-vuex": "^4.1.0",
    "@vue/cli-service": "^4.1.0",
    "@vue/eslint-config-airbnb": "^4.0.0",
    "@vue/test-utils": "1.0.0-beta.29",
    "babel-eslint": "^10.0.3",
    "eslint": "^5.16.0",
    "eslint-plugin-vue": "^5.0.0",
    "lint-staged": "^9.4.3",
    "sass-loader": "^8.0.0",
    "vue-template-compiler": "^2.6.10"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "vue-cli-service lint",
      "git add"
    ]
  }
}
